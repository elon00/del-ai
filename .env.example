# =================================================================
# 🏆 DELPHI AGENT ARENA - CONFIGURATION
# =================================================================

# 1. DELPHI NETWORK (कम्पटीशन के लिए "competition-testnet" रहेगा)
DELPHI_NETWORK=competition-testnet
DELPHI_SIGNER_TYPE=private_key

# 2. आपका नया EVM वॉलेट प्राइवेट की (MetaMask से export किया हुआ)
# नोट: जब तक यह नहीं डालेंगे, बॉट सुरक्षित SIMULATION MODE में चलेगा।
WALLET_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# 3. DELPHI API ACCESS KEY (https://competition.delphi.fyi/ से जनरेट करें)
DELPHI_API_ACCESS_KEY=YOUR_DELPHI_API_KEY_HERE

# 4. GOOGLE GEMINI API KEY (AI Superforecaster के लिए)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 5. RISK & TRADING PARAMS (क्वांटिटेटिव रिस्क सेटिंग्स)
DRY_RUN=true
MIN_EDGE=0.05
KELLY_MULTIPLIER=0.30
MAX_SINGLE_BET_PCT=0.12
MAX_TOTAL_EXPOSURE_PCT=0.80
MIN_CONFIDENCE=0.60
POLL_INTERVAL_MS=180000
AUTO_REDEEM=true
